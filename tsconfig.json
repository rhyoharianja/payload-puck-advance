{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "rootDir": "./",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    // `nodenext`, sama dengan plugin lain di workspace ini.
    //
    // Konsekuensinya: subpath `next` HARUS ditulis dengan ekstensi —
    // `next/cache.js`, bukan `next/cache`. Paket `next` tidak punya field
    // `exports`, jadi di resolusi ESM murni ia di-resolve sebagai path file
    // biasa, dan file tanpa ekstensi tidak bisa dimuat. `pay-admin-theme`
    // sudah memakai pola yang sama untuk `next/navigation.js`.
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "emitDeclarationOnly": true,
    "target": "ES2022",
    "composite": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
