{
  "name": "payload-puck-advance",
  "version": "0.1.0",
  "description": "Penyunting visual Puck untuk collection Payload yang sudah ada — definisi block tetap milik Payload",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./next": {
      "import": "./dist/exports/next.js",
      "types": "./dist/exports/next.d.ts",
      "default": "./dist/exports/next.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,json}\" dist/",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --watch"
  },
  "devDependencies": {
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@puckeditor/core": "0.23.0",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "eslint": "^9.23.0",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@payloadcms/live-preview-react": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "next": "^15.4.8 || ^16.0.0",
    "payload": "^3.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/live-preview-react": {
      "optional": true
    },
    "@payloadcms/ui": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "author": "Suryo Galih Kencana Harianja <harianja.suryo@gmail.com>",
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "puck",
    "visual-editor",
    "blocks",
    "page-builder"
  ],
  "bin": {
    "payload-puck-advance": "./bin/payload-puck-advance.mjs"
  },
  "dependencies": {
    "@puckeditor/core": "0.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhyoharianja/payload-puck-advance.git"
  },
  "bugs": {
    "url": "https://github.com/rhyoharianja/payload-puck-advance/issues"
  },
  "homepage": "https://github.com/rhyoharianja/payload-puck-advance#readme"
}
